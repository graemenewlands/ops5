;;; ============================================================================
;;; Section 2.4.3 Part C: Ancestor Search with Negative Assertion Termination
;;;
;;; Problem: Clean termination of ancestor search preventing the initial target
;;; person from being reported as their own ancestor.
;;; Strategy: Introduces FindAncestors::Stop with a negative condition element:
;;; - (Request ^type ancestor ^target {<> <name1> <> nil})
;;; This matches only when no other non-nil requests exist in working memory.
;;; When only the root request remains, FindAncestors::Stop (specificity 8)
;;; dominates FindAncestors::Print (specificity 4), prints "No More Ancestors",
;;; and calls (halt).
;;; ============================================================================

;; ----------------------------------------------------------------------------
;; Rule 1: FindAncestors::Initialize
;; Matches the initial (Start) token, prompts the user interactively via (accept),
;; and creates the root ancestor request.
;; ----------------------------------------------------------------------------
(p FindAncestors::Initialize
        {(Start) <initialize>}
    -->
        (remove <initialize>)
        (write (crlf) |Please type the first name of a person|
            (crlf) |whose ancestors you would like to find:|
            (crlf))
        (make Request ^type ancestor ^target (accept))
)

;; ----------------------------------------------------------------------------
;; Rule 2: FindAncestors (Generator)
;; Matches an active Request for a person who has parents in the database.
;; Asserts two child requests for mother and father without retracting current request.
;; Specificity = 8 (2 condition elements), dominating FindAncestors::Print.
;; ----------------------------------------------------------------------------
(p FindAncestors
        (Request ^type ancestor ^target {<name> <> nil})
        (Person ^name <name> ^mother <mother-name> 
            ^father <father-name>)
    -->
        (make Request ^type ancestor ^target <mother-name>)
        (make Request ^type ancestor ^target <father-name>)    
)

;; ----------------------------------------------------------------------------
;; Rule 3: FindAncestors::Print (Reporter)
;; Matches an active Request. Fires after FindAncestors refracts for that request,
;; or immediately for leaf ancestors with no parent entries in WM.
;; Prints '<name> is an ancestor' and removes the request. Specificity = 4.
;; ----------------------------------------------------------------------------
(p FindAncestors::Print
        {(Request ^type ancestor ^target {<name> <> nil}) <request1>}
    -->
        (write (crlf) <name> is an ancestor)
        (remove <request1>)
)

;; ----------------------------------------------------------------------------
;; Rule 4: FindAncestors::Stop (Terminator)
;; Negative working memory assertion:
;; Matches when there is an active Request (<name1>), but NO OTHER non-nil
;; Request exists in working memory.
;;
;; During recursive traversal, multiple requests always coexist in WM.
;; Only when all true ancestors have been printed and retracted does the
;; root request remain alone in WM.
;; With specificity = 8, this rule dominates FindAncestors::Print (specificity 4),
;; printing "No More Ancestors" and halting cleanly without reporting the root person.
;; ----------------------------------------------------------------------------
(p FindAncestors::Stop
        (Request ^type ancestor ^target {<name1> <> nil})
        - (Request ^type ancestor ^target {<> <name1> <> nil})
    -->
        (write (crlf) No More Ancestors (crlf))
        (halt)
)

;;; ============================================================================
;;; Initial Working Memory: Family Tree (Genealogy Database)
;;; ============================================================================
(Person ^name Penelope ^mother Jessica ^father Jeremy)
(Person ^name Jessica mother Mary-Elizabeth ^father Homer)
(Person ^name Jeremy ^mother Jenny ^father Steven)
(Person ^name Steven ^mother Loree)
(Person ^name Loree ^father Jason)
(Person ^name Homer ^mother Stephanie)