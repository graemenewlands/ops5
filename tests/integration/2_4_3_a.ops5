;;; ============================================================================
;;; Section 2.4.3 Part A: Ancestor Search (Single Recursive Rule)
;;;
;;; Problem: Find all ancestors of a designated person in a family tree.
;;; Strategy: Single recursive rule (PrintAncestors) that matches a request,
;;; prints both parents as a pair, retracts the request, and generates two
;;; sub-requests for the parents.
;;; ============================================================================

;; ----------------------------------------------------------------------------
;; Rule 1: FindAncestors::Initialize
;; Matches the initial (Start) token, prompts the user interactively via (accept),
;; and creates the root ancestor request.
;; ----------------------------------------------------------------------------
(p FindAncestors::Initialize
        {(Start) <initialize>}
    -->
        (remove <initialize>)
        (write (crlf) |Please type the first name of a person|
            (crlf) |whose ancestors you would like to find:|
            (crlf))
        (make Request ^type ancestor ^target (accept))
)

;; ----------------------------------------------------------------------------
;; Rule 2: PrintAncestors
;; Matches an active Request and the corresponding Person entry.
;; Retracts the current request, prints both mother and father, and asserts
;; new requests for both parents. The {<myparents> <> nil} constraint prevents
;; recursion on unknown ancestors.
;; ----------------------------------------------------------------------------
(p PrintAncestors
        {(Request ^type ancestor
            ^target {<myparents> <> nil}) <request1>}
        (Person ^name <myparents> ^mother <mother-name>
            ^father <father-name>)
    -->
        (remove <request1>)
        (write (crlf) <mother-name> and
                      <father-name> are ancestors
                        via <myparents>)
        (make Request ^type ancestor ^target <mother-name>)
        (make Request ^type ancestor ^target <father-name>)    
)

;;; ============================================================================
;;; Initial Working Memory: Family Tree (Genealogy Database)
;;; ============================================================================
(Person ^name Penelope ^mother Jessica ^father Jeremy)
(Person ^name Jessica mother Mary-Elizabeth ^father Homer)
(Person ^name Jeremy ^mother Jenny ^father Steven)
(Person ^name Steven ^mother Loree)
(Person ^name Loree ^father Jason)
(Person ^name Homer ^mother Stephanie)
