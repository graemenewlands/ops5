{
  "name": "cbind_workflow_test",
  "description": "Validates cbind action to bind newly asserted and modified WMEs to element variables",
  "strategy": "LEX",
  "source_file": "fixtures/cbind_workflow.ops",
  "initial_wm": [
    {
      "class": "stage",
      "attributes": {
        "name": "init"
      }
    }
  ],
  "max_cycles": 10,
  "expected_cycles": 2,
  "expected_wm": [
    {
      "class": "stage",
      "attributes": {
        "name": "run"
      }
    },
    {
      "class": "order",
      "attributes": {
        "id": "101",
        "status": "completed",
        "total": "150"
      }
    },
    {
      "class": "log-entry",
      "attributes": {
        "message": "done"
      }
    }
  ],
  "forbidden_wm": [
    {
      "class": "order",
      "attributes": {
        "status": "created"
      }
    },
    {
      "class": "order",
      "attributes": {
        "status": "processing"
      }
    }
  ],
  "expected_outputs": [
    "Order",
    "101",
    "completed with reference"
  ]
}
